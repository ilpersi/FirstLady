# Environment variables
.env

# archives
*\.7z
*\.zip
*\.rar

# Run time folders
logs/
tmp/
state/
screenshots/

# Python bytecode / pytest cache
__pycache__/
*.pyc
.pytest_cache/

# Pycharm Files
*\.iml
\.idea
venv/

# External executables
*\.exe

# We only include default templates
config/templates/*
!config/templates/default/
!config/templates/default/**
